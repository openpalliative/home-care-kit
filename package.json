{
  "name": "home-care-kit",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test:unit": "node --test \"tests/unit/**/*.test.js\"",
    "test:e2e": "playwright test --grep-invert \"@shots|@p6\"",
    "shots": "playwright test --grep @shots",
    "shots:p6": "playwright test --grep @p6 --project=desktop",
    "gate": "sh scripts/gate.sh"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@axe-core/playwright": "4.13.0",
    "jsqr": "1.4.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": []
  }
}
