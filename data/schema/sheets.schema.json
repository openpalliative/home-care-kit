{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Листы для дома: описание листов, полей и блоков",
  "type": "object",
  "required": ["dataset", "items"],
  "properties": {
    "dataset": { "const": "sheets" },
    "items": {
      "type": "array",
      "minItems": 5,
      "items": { "$ref": "#/$defs/sheet" }
    }
  },
  "$defs": {
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "date": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "x-message-ru": "дата в виде ГГГГ-ММ-ДД или пусто" },
    "text": { "type": "string", "minLength": 1 },
    "norm_ids": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" } },
    "review": {
      "type": "object",
      "required": ["needs", "reviewed_by", "reviewed_at"],
      "additionalProperties": false,
      "properties": {
        "needs": { "enum": ["none", "legal", "medical", "both"] },
        "reviewed_by": { "type": ["string", "null"] },
        "reviewed_at": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
      }
    },
    "quote_ref": {
      "type": "object",
      "required": ["quote_id"],
      "additionalProperties": false,
      "properties": {
        "quote_id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" }
      }
    },
    "link": {
      "type": "object",
      "required": ["label", "repo", "path"],
      "additionalProperties": false,
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "repo": { "enum": ["openpalliative.github.io", "pal-norms", "pal-devices-data", "obrashchenie-kit", "home-care-kit", "pal-directory"] },
        "path": { "type": "string", "pattern": "^([a-z0-9-]+/)*$" },
        "params": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "item": {
      "type": "object",
      "required": ["id", "text", "verified", "verified_at", "review"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "text": { "type": "string", "minLength": 1 },
        "detail": { "type": "string" },
        "who": { "type": "string" },
        "when": { "type": "string" },
        "branch": { "enum": ["all", "has-vk", "no-vk"] },
        "norm_ids": { "type": "array", "items": { "type": "string" } },
        "quote_refs": { "type": "array", "items": { "$ref": "#/$defs/quote_ref" } },
        "links": { "type": "array", "items": { "$ref": "#/$defs/link" } },
        "verified": { "type": "boolean" },
        "verified_at": { "type": ["string", "null"] },
        "source_ref": { "type": "string" },
        "review": { "$ref": "#/$defs/review" }
      }
    },
    "field": {
      "type": "object",
      "required": ["id", "label", "type", "max_len"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(_[a-z0-9]+)*$" },
        "label": { "type": "string", "minLength": 1 },
        "hint": { "type": "string" },
        "print_label": { "type": "string" },
        "type": { "enum": ["text", "tel", "date", "textarea"] },
        "max_len": { "type": "integer", "minimum": 1, "maximum": 400 },
        "required": { "type": "boolean" },
        "autocomplete": { "type": "string" },
        "blank_lines": { "type": "integer", "minimum": 1, "maximum": 6 },
        "fixed_caption": { "type": "string" },
        "suggest": { "enum": ["now", "region"] },
        "suggest_id": { "type": "string" },
        "confirm": { "type": "boolean" },
        "qr_order": { "type": ["integer", "null"], "minimum": 1 },
        "qr_key": { "type": "string" },
        "demo": { "type": "string" }
      }
    },
    "block": {
      "type": "object",
      "required": ["id", "kind", "print", "verified", "verified_at", "review"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "kind": { "enum": ["text", "locked", "script", "fields", "numbers", "holidays", "checklist", "quote", "indications", "not-automatic", "placeholder", "qr", "outcomes"] },
        "title": { "type": "string" },
        "text": { "type": "string" },
        "lines": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "items": { "type": "array", "items": { "$ref": "#/$defs/item" } },
        "field_ids": { "type": "array", "items": { "type": "string" } },
        "now_ids": { "type": "array", "items": { "enum": ["emergency", "ambulance", "hotline"] } },
        "region_roles": { "type": "array", "items": { "type": "string" } },
        "groups": { "type": "array", "items": { "enum": ["general", "dementia", "stroke", "als", "chf"] } },
        "norm_ids": { "type": "array", "items": { "type": "string" } },
        "quote_refs": { "type": "array", "items": { "$ref": "#/$defs/quote_ref" } },
        "links": { "type": "array", "items": { "$ref": "#/$defs/link" } },
        "screen": { "type": "boolean" },
        "print": { "type": "boolean" },
        "verified": { "type": "boolean" },
        "verified_at": { "type": ["string", "null"] },
        "source_ref": { "type": "string" },
        "review": { "$ref": "#/$defs/review" }
      }
    },
    "section": {
      "type": "object",
      "required": ["id", "title", "blocks"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "title": { "type": "string", "minLength": 1 },
        "side": { "type": ["integer", "null"], "minimum": 1, "maximum": 2 },
        "anchor": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "branch": { "enum": ["all", "has-vk", "no-vk"] },
        "blocks": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/block" } }
      }
    },
    "option": {
      "type": "object",
      "required": ["value", "label"],
      "additionalProperties": false,
      "properties": {
        "value": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "label": { "type": "string", "minLength": 1 },
        "next": { "type": "string" },
        "outcomes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "question": {
      "type": "object",
      "required": ["id", "text", "options"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "text": { "type": "string", "minLength": 1 },
        "help": { "type": "string" },
        "options": { "type": "array", "minItems": 2, "maxItems": 4, "items": { "$ref": "#/$defs/option" } }
      }
    },
    "outcome": {
      "type": "object",
      "required": ["id", "title", "what", "verified", "verified_at", "review"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "title": { "type": "string", "minLength": 1 },
        "what": { "type": "string", "minLength": 1 },
        "take": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "always": { "type": "boolean" },
        "norm_ids": { "type": "array", "items": { "type": "string" } },
        "quote_refs": { "type": "array", "items": { "$ref": "#/$defs/quote_ref" } },
        "links": { "type": "array", "items": { "$ref": "#/$defs/link" } },
        "verified": { "type": "boolean" },
        "verified_at": { "type": ["string", "null"] },
        "review": { "$ref": "#/$defs/review" }
      }
    },
    "tree": {
      "type": "object",
      "required": ["start", "questions", "outcomes"],
      "additionalProperties": false,
      "properties": {
        "start": { "type": "string" },
        "questions": { "type": "array", "minItems": 3, "maxItems": 7, "items": { "$ref": "#/$defs/question" } },
        "outcomes": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/outcome" } }
      }
    },
    "sheet": {
      "type": "object",
      "required": ["id", "title", "summary", "path", "minutes", "paper", "print_pages", "storage", "validity", "draft", "version", "verified", "verified_at", "review", "steps", "fields", "sections"],
      "additionalProperties": false,
      "properties": {
        "id": { "enum": ["night", "emergency", "discharge", "conclusion", "ahead"] },
        "title": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "pattern": "^[a-z0-9-]+/$" },
        "minutes": { "type": "integer", "minimum": 1, "maximum": 30 },
        "paper": { "type": "array", "minItems": 1, "items": { "enum": ["a4", "wallet"] } },
        "print_pages": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "a4": { "type": "integer", "minimum": 1, "maximum": 3 },
            "wallet": { "type": "integer", "minimum": 1, "maximum": 1 }
          }
        },
        "storage": { "enum": ["save", "ask", "none"] },
        "validity": {
          "type": "object",
          "required": ["rule"],
          "additionalProperties": false,
          "properties": {
            "rule": { "enum": ["recheck", "watermark", "none"] },
            "recheck_days": { "type": "integer", "minimum": 30, "maximum": 366 },
            "line_days": { "type": "integer", "minimum": 30, "maximum": 730 },
            "watermark_days": { "type": "integer", "minimum": 30, "maximum": 366 }
          }
        },
        "draft": { "enum": ["none", "legal", "medical", "both"] },
        "version": { "type": "string", "pattern": "^\\d{4}\\.\\d{2}\\.\\d{2}(\\.\\d+)?$" },
        "verified": { "type": "boolean" },
        "verified_at": { "type": ["string", "null"] },
        "review": { "$ref": "#/$defs/review" },
        "situations": { "type": "array", "items": { "type": "string" } },
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "type": "object",
            "required": ["id", "title"],
            "additionalProperties": false,
            "properties": {
              "id": { "enum": ["fill", "check", "print"] },
              "title": { "type": "string", "minLength": 1 },
              "text": { "type": "string" }
            }
          }
        },
        "fields": { "type": "array", "items": { "$ref": "#/$defs/field" } },
        "sections": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/section" } },
        "tree": { "$ref": "#/$defs/tree" }
      }
    }
  }
}
