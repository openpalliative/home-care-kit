{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Листы для дома: регионы и номера из снимка pal-directory (внутренний датасет)",
  "type": "object",
  "required": ["dataset", "items"],
  "properties": {
    "dataset": { "const": "region-view" },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "lines", "verified", "verified_at"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^RU-[A-Z]{2,3}$" },
          "name": { "type": "string", "minLength": 1 },
          "verified": { "type": "boolean" },
          "verified_at": { "type": ["string", "null"] },
          "lines": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "role", "label", "phone", "verified", "verified_at", "printable"],
              "additionalProperties": false,
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "role": { "type": "string", "minLength": 1 },
                "label": { "type": "string", "minLength": 1 },
                "phone": { "type": "string", "pattern": "^(8-800-\\d{3}-\\d{2}-\\d{2}|\\+7 \\d{3} \\d{3}-\\d{2}-\\d{2}|8 \\(\\d{3,5}\\) \\d{1,3}-\\d{2}-\\d{2}|\\d{3})$" },
                "ext": { "type": ["string", "null"], "pattern": "^\\d[\\d-]*$" },
                "hours": { "type": ["string", "null"] },
                "is_24x7": { "type": ["boolean", "null"] },
                "other_org": { "type": "boolean" },
                "printable": { "type": "boolean" },
                "demo": { "type": "boolean" },
                "verified": { "type": "boolean" },
                "verified_at": { "type": ["string", "null"] },
                "source_ref": { "type": "string" },
                "source_title": { "type": "string" },
                "source_date": { "type": ["string", "null"] }
              }
            }
          }
        }
      }
    }
  }
}
