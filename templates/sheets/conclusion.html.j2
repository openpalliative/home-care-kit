{% extends "hc/layout.html.j2" %}
{% import "partials/sheet.html.j2" as hc with context %}
{% set sheet = site.hc.sheets[sheet_id] %}
{% set crumb = sheet.title %}
{% block title %}{{ sheet.title }}{% endblock %}
{% block description %}{{ sheet.summary }}{% endblock %}
{% block page_head %}<link rel="stylesheet" href="{{ url('assets/css/hc-doc.css') }}">
<script type="module" src="{{ url('assets/js/hc-branch.js') }}"></script>{% endblock %}
{% block page_class %} hc-page--doc{% endblock %}
{% block content %}
{{ hc.head(sheet, ("Кто решает о заключении, где читать показания" if site.hc.indications_stub else "Что написано в приказе о показаниях") ~ " и что нужно просить отдельно, даже когда заключение уже есть. Можно распечатать и взять на приём к врачу") }}
<hc-branch class="hc-branch" data-mode="group">
  {{ hc.nojs_note(true) }}
  <article class="hc-doc">
    {{ hc.print_head(sheet) }}
    {% for sec in sheet.sections_view if not (site.hc.indications_stub and sec.blocks | selectattr("kind", "equalto", "indications") | rejectattr("groups", "equalto", ["general"]) | list) %}
    <section class="hc-dsec" aria-labelledby="hc-sec-{{ sec.id }}">
      <h2 id="hc-sec-{{ sec.id }}">{{ sec.title }}</h2>
      {% for b in sec.blocks %}
      {% if b.kind == "indications" and site.hc.indications_stub %}
      {% if b.groups == ["general"] %}
      {% set act = b.acts[0] if b.acts else {} %}
      <p class="hc-ind-link" data-hc-ind-link>Текст показаний смотрите в официальной публикации: {% if act.url %}<a href="{{ act.url }}">{{ act.title or "Положение о паллиативной медицинской помощи" }}, приложение 1</a>{% else %}{{ act.title or "Положение о паллиативной медицинской помощи" }}, приложение 1{% endif %}{% if act.eoNumber %}<span class="hc-print-only-inline">, publication.pravo.gov.ru/document/{{ act.eoNumber }}</span>{% endif %}</p>
      {% endif %}
      {% elif b.kind == "indications" and b.groups == ["general"] %}
      {{ hc.indications(b.groups_view.general, sheet.path) }}
      {% for l in b.links %}<p class="hc-links hc-screen"><a href="{{ xurl(l.repo, l.path, l.get('params')) }}">{{ l.label }}</a></p>{% endfor %}
      {% elif b.kind == "indications" %}
      <fieldset class="op-choice hc-groups hc-js-only hc-screen" data-hc-groups>
        <legend class="op-field__label">Какое заболевание у человека?</legend>
        <p class="op-field__hint">Покажем пункты только этой группы. Выбор не сохраняется и не попадает в адрес страницы</p>
        {% for g, label in site.hc.groups %}
        <label class="op-choice__item"><input type="radio" name="hc-group" value="{{ g }}"><span>{{ label }}</span></label>
        {% endfor %}
      </fieldset>
      {% for g, label in site.hc.groups if g in b.groups_view %}
      <details class="hc-group-ind" data-hc-group="{{ g }}" open>
        <summary>{{ label }}</summary>
        {{ hc.indications(b.groups_view[g], sheet.path, b.group_intro.get(g)) }}
      </details>
      {% endfor %}
      <div class="hc-group-other" data-hc-group="other" hidden>
        <p>Общие показания выше подходят для любого заболевания. Кроме них, в приложении 1 к положению есть показания по таким группам заболеваний:</p>
        <ul class="hc-group-list">
          {% for h in b.all_groups %}<li>{% if h.printable %}<span data-verbatim>{{ h.title }}</span>{% else %}{{ h.point }}, текст ещё сверяется{% endif %}</li>{% endfor %}
        </ul>
        <p>Полный перечень с пунктами смотрите в разделе <a href="{{ xurl('pal-norms', 'indications/') }}">«Показания дословно»</a>. Какие показания относятся к человеку, решает врач</p>
      </div>
      {% elif b.kind == "quote" %}
      <h3>{{ b.title }}</h3>
      {% set whole = b.printable and not (b.quotes | rejectattr("printable") | list) %}
      {{ hc.quote_screen(b, whole) }}
      {% if b.printable and not whole %}<div class="hc-print-only">{{ hc.quote_print(b) }}</div>{% elif not b.printable %}<p class="hc-print-only hc-skipped">{{ b.quotes | length | plural("пункт не проверен", "пункта не проверены", "пунктов не проверены") }}, смотрите на экране: {{ hc.page_addr(sheet.path) }}</p>{% endif %}
      {% elif b.kind == "not-automatic" %}
      <p class="hc-dsec__lead">Заключение само не приносит этого. Просить нужно отдельно, лучше письменно</p>
      {{ hc.checklist(b, sheet.path) }}
      {% elif b.kind == "text" %}
      <div class="{{ 'hc-screen' if not b.printable }}">
        <p>{{ b.text }}</p>
        {% if b.links %}<ul class="hc-linklist">{% for l in b.links %}<li><a href="{{ xurl(l.repo, l.path, l.get('params')) }}">{{ l.label }}</a></li>{% endfor %}</ul>{% endif %}
      </div>
      {% endif %}
      {% endfor %}
    </section>
    {% endfor %}
    {{ hc.sheet_footer(sheet, "conclusion/", validity=false) }}
  </article>
  {% if not site.hc.indications_stub %}<p class="hc-print-hint hc-screen hc-js-only">С выбранным заболеванием лист займёт {{ sheet.print_pages.get("a4", 2) | plural("страницу", "страницы", "страниц") }}. Без выбора печатаются все группы, это на страницу больше</p>{% endif %}
  {{ hc.print_bar() }}
</hc-branch>
{{ hc.more(sheet) }}
{% endblock %}
